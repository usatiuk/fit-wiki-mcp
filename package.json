{
  "name": "fit-wiki-mcp",
  "version": "0.1.9",
  "description": "Model Context Protocol server and CLI for FIT Wiki.",
  "type": "module",
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "import": "./dist/auth.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./tools": {
      "types": "./dist/tools.d.ts",
      "import": "./dist/tools.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "fit-wiki-mcp": "dist/server.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "npm run typecheck && npm test && npm run build",
    "dev": "tsx src/server.ts",
    "cli": "tsx src/cli.ts",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "audit:prod": "npm audit --omit=dev",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "dokuwiki",
    "fit-wiki",
    "cvut"
  ],
  "license": "AGPL-3.0-or-later",
  "author": "usatiuk <stepan@usatiuk.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usatiuk/fit-wiki-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/usatiuk/fit-wiki-mcp/issues"
  },
  "homepage": "https://github.com/usatiuk/fit-wiki-mcp#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@napi-rs/keyring": "^1.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "cheerio": "^1.0.0",
    "pdfjs-dist": "^5.7.284",
    "turndown": "^7.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "@types/turndown": "^5.0.5",
    "tsx": "^4.19.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
